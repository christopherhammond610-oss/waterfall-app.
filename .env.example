# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: never add NEXT_PUBLIC_ to this one
SUPABASE_SECRET_KEY=

# Stripe (Developers -> API keys). Use sk_test_... until going live. Server only.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (whsec_...). Locally: from `stripe listen`.
STRIPE_WEBHOOK_SECRET=

# Public site URL for Stripe redirects, e.g. https://thewaterfall.netlify.app
# (optional locally: falls back to the request origin)
SITE_URL=
